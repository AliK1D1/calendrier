      "checkConstraints": {
        "busy_blocks_meetup_link": {
          "name": "busy_blocks_meetup_link",
          "value": "(\"busy_blocks\".\"source\"::text = 'meetup') = (\"busy_blocks\".\"meetup_plan_id\" is not null)"
        },
        "busy_blocks_study_link": {
          "name": "busy_blocks_study_link",
          "value": "(\"busy_blocks\".\"source\"::text = 'study') = (\"busy_blocks\".\"deadline_id\" is not null)"
        },
        "busy_blocks_study_one_off": {
          "name": "busy_blocks_study_one_off",
          "value": "\"busy_blocks\".\"source\"::text <> 'study' or \"busy_blocks\".\"weekday\" is null"
        },
        "busy_blocks_movable_study": {
          "name": "busy_blocks_movable_study",
          "value": "not \"busy_blocks\".\"movable\" or \"busy_blocks\".\"source\"::text = 'study'"
        },
        "busy_blocks_outlook_one_off": {
          "name": "busy_blocks_outlook_one_off",
          "value": "\"busy_blocks\".\"source\"::text <> 'outlook' or (\"busy_blocks\".\"weekday\" is null and \"busy_blocks\".\"place_id\" is null)"
        },
        "busy_blocks_time_order": {
          "name": "busy_blocks_time_order",
          "value": "\"busy_blocks\".\"end_time\" > \"busy_blocks\".\"start_time\""
        },
        "busy_blocks_weekday_range": {
          "name": "busy_blocks_weekday_range",
          "value": "\"busy_blocks\".\"weekday\" is null or \"busy_blocks\".\"weekday\" between 1 and 7"
        },
        "busy_blocks_validity_order": {
          "name": "busy_blocks_validity_order",
          "value": "\"busy_blocks\".\"valid_from\" is null or \"busy_blocks\".\"valid_until\" is null or \"busy_blocks\".\"valid_until\" >= \"busy_blocks\".\"valid_from\""
        },
        "busy_blocks_title_length": {
          "name": "busy_blocks_title_length",
          "value": "length(\"busy_blocks\".\"title\") <= 100"
        },
        "busy_blocks_validity_span": {
          "name": "busy_blocks_validity_span",
          "value": "\"busy_blocks\".\"valid_from\" is null or \"busy_blocks\".\"valid_until\" is null or \"busy_blocks\".\"valid_until\" - \"busy_blocks\".\"valid_from\" < (case when \"busy_blocks\".\"repeat_unit\" is null then 366 else 3660 end)"
        },
        "busy_blocks_one_off_has_day": {
          "name": "busy_blocks_one_off_has_day",
          "value": "\"busy_blocks\".\"weekday\" is not null or \"busy_blocks\".\"repeat_unit\" is not null or (\"busy_blocks\".\"valid_from\" is not null and (\"busy_blocks\".\"valid_until\" is null or \"busy_blocks\".\"valid_until\" = \"busy_blocks\".\"valid_from\"))"
        },
        "busy_blocks_repeat_every_range": {
          "name": "busy_blocks_repeat_every_range",
          "value": "\"busy_blocks\".\"repeat_every\" between 1 and 99"
        },
        "busy_blocks_repeat_shape": {
          "name": "busy_blocks_repeat_shape",
          "value": "(\"busy_blocks\".\"repeat_unit\" is null and \"busy_blocks\".\"repeat_every\" = 1) or (\"busy_blocks\".\"repeat_unit\" is not null and ((\"busy_blocks\".\"repeat_unit\" = 'week' and \"busy_blocks\".\"weekday\" is not null and \"busy_blocks\".\"valid_from\" is not null) or (\"busy_blocks\".\"repeat_unit\" in ('day', 'month', 'year') and \"busy_blocks\".\"weekday\" is null and \"busy_blocks\".\"valid_from\" is not null)))"
        },
        "busy_blocks_repeat_manual": {
          "name": "busy_blocks_repeat_manual",
          "value": "\"busy_blocks\".\"repeat_unit\" is null or \"busy_blocks\".\"source\"::text = 'manual'"
        }
